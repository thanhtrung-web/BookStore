<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="false">

    <display-name>BookStore Management System</display-name>

    <!-- Application Startup Listener -->
    <listener>
        <listener-class>com.bookstore.listener.AppStartupListener</listener-class>
    </listener>

    <!-- Encoding Filter (UTF-8) -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.bookstore.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Static Resources Mapping (Images, CSS, JS) -->
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/static/*</url-pattern>
    </servlet-mapping>

    <!-- HomeController Servlet -->
    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>com.bookstore.controller.HomeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/home</url-pattern>
        <url-pattern></url-pattern>
    </servlet-mapping>

    <!-- AuthController Servlet (UC-01 Register, UC-02 Login, UC-03 Logout) -->
    <servlet>
        <servlet-name>AuthController</servlet-name>
        <servlet-class>com.bookstore.controller.AuthController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthController</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/register</url-pattern>
        <url-pattern>/verify-email</url-pattern>
        <url-pattern>/resend-activation</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration (60 minutes per UC-02 Sequence Diagram) -->
    <session-config>
        <session-timeout>60</session-timeout>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    
    <servlet>
    <servlet-name>CartController</servlet-name>
    <servlet-class>com.bookstore.controller.CartController</servlet-class>
    </servlet>

    <servlet-mapping>
    <servlet-name>CartController</servlet-name>
    <url-pattern>/cart</url-pattern>
    <url-pattern>/cart/add</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>OrderController</servlet-name>
        <servlet-class>com.bookstore.controller.OrderController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>OrderController</servlet-name>
        <url-pattern>/order/checkout</url-pattern>
    </servlet-mapping>

</web-app>
