<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="false">

    <display-name>BookStore Management System</display-name>

    <!-- Application Startup Listener -->
    <listener>
        <listener-class>com.bookstore.listener.AppStartupListener</listener-class>
    </listener>

    <!-- Encoding Filter (UTF-8) -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.bookstore.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Role-Based Access Control Filter (TSK-06 / BR-03) -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.bookstore.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/change-password</url-pattern>
        <url-pattern>/checkout</url-pattern>
        <url-pattern>/checkout/*</url-pattern>
        <url-pattern>/orders</url-pattern>
        <url-pattern>/orders/*</url-pattern>
        <url-pattern>/wishlist</url-pattern>
        <url-pattern>/wishlist/*</url-pattern>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/staff/*</url-pattern>
        <url-pattern>/inventory/*</url-pattern>
    </filter-mapping>

    <!-- Static Resources Mapping (Images, CSS, JS) -->
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/static/*</url-pattern>
    </servlet-mapping>

    <!-- HomeController Servlet -->
    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>com.bookstore.controller.HomeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/home</url-pattern>
        <url-pattern></url-pattern>
    </servlet-mapping>

    <!-- AuthController Servlet (UC-01 Register, UC-02 Login, UC-03 Logout) -->
    <servlet>
        <servlet-name>AuthController</servlet-name>
        <servlet-class>com.bookstore.controller.AuthController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthController</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/register</url-pattern>
        <url-pattern>/verify-email</url-pattern>
        <url-pattern>/resend-activation</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- UserController Servlet (TSK-07: UC-43 View Profile, UC-44 Update Profile, UC-05 Change Password) -->
    <servlet>
        <servlet-name>UserController</servlet-name>
        <servlet-class>com.bookstore.controller.UserController</servlet-class>
        <multipart-config>
            <max-file-size>2097152</max-file-size>
            <max-request-size>5242880</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserController</servlet-name>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/change-password</url-pattern>
    </servlet-mapping>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration (60 minutes per UC-02 Sequence Diagram) -->
    <session-config>
        <session-timeout>60</session-timeout>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

</web-app>
